// ============================================================================
//  OPPORTUNITY LIST HEADER (NON-gallery).  Control: Image "imgOppHeader"
//  Geometry: X=16  Y=230  Width=420  Height=30   ImagePosition=Fit
//  Sits above the galCrewOpps gallery — bakes the section title so the gallery
//  itself stays a plain row list.
// ============================================================================
"data:image/svg+xml;utf8," & EncodeUrl(
    "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 420 30' font-family='Segoe UI, Arial, sans-serif'>" & varSvgCss &
    "<text x='4' y='19' font-size='11' font-weight='700' letter-spacing='1.2' fill='#606a70'>CREW PIPELINE</text>" &
    "<text x='416' y='19' font-size='11' fill='#606a70' text-anchor='end'>" & Text( CountRows( colOpps ) ) & " opportunities</text>" &
    "</svg>"
)
