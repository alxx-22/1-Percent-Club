// ============================================================================
//  RANKS HEADER — title strip above the gallery.  Control: Image "imgRanksHeader"
//  Geometry: X=452  Y=380  Width=668  Height=28   ImagePosition=Fit
// ============================================================================
"data:image/svg+xml;utf8," & EncodeUrl(
    "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 668 28' font-family='Segoe UI, Arial, sans-serif'>" &
    "<text x='4' y='19' font-size='11' font-weight='700' letter-spacing='1.2' fill='#606a70'>RANKS 4&#8211;10</text>" &
    "<text x='664' y='19' font-size='11' fill='#606a70' text-anchor='end'>" & Text(CountRows(colCrew)) & " crews total</text>" &
    "</svg>"
)
