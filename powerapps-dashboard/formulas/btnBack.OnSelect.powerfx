// ============================================================================
//  btnBack.OnSelect  —  "← Dashboard" on the Crew Portal ribbon.
//
//  RECOMMENDED PLACEMENT: put the SVG button image "imgBackBtn" (see
//  imgBackBtn.Image.powerfx) at X=16 Y=11 W=132 H=30 (ImagePosition=Fit) and
//  paste THIS formula into imgBackBtn.OnSelect (Image controls are tappable).
//  ALTERNATIVE: a transparent Button over imgBackBtn for hover/press feedback.
//
//  Plays the leaf-wipe transition and returns to the dashboard. UnCover mirrors
//  the Cover used on the way in.
// ============================================================================
Set( varLeafKey, varLeafKey + 1 );
Set( varLeafBusy, true );
Navigate( scrDashboard, ScreenTransition.UnCover )
