// ============================================================================
//  CLOSE BUTTON (SVG).  Control: Image "imgClose"
//  Geometry (over the chat header, top-right):
//        X=container.X+324  Y=container.Y+16  Width=28  Height=28
//        ImagePosition=Fit   OnSelect = imgClose.OnSelect.powerfx
//  A soft white ghost circle + X; sits on the green header.
// ============================================================================
"data:image/svg+xml;utf8," & EncodeUrl(
    "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 28 28'>" &
    "<circle cx='14' cy='14' r='13' fill='#ffffff' opacity='.20'/>" &
    "<path d='M9,9 L19,19 M19,9 L9,19' stroke='#ffffff' stroke-width='2.2' stroke-linecap='round'/>" &
    "</svg>"
)
