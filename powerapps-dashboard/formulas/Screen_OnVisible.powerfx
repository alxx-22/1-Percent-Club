// ============================================================================
//  Screen.OnVisible  —  BUILDS ALL DASHBOARD DATA (put it here, not in a Timer).
//
//  Reads every field through TEXT first  ->  Value( field & "" )  so Power BI
//  type quirks can't break the load. Symptom this fixes: rows>0 but colMembers=0
//  plus a red "JSON parsing error, expected 'number' but got 'string'" — that
//  means a numeric column is arriving as text; coercing through text avoids it.
//  We also read only the columns we use, so an unrelated bad column is ignored.
//
//  If it STILL errors after this, one of the POINT columns is typed as Text in
//  the Power BI model — set those columns to Whole Number in Power BI (Modeling
//  > Data type) and reload. See DEBUG.md.
// ============================================================================

// 1) members (typed + totals) ---------------------------------------------
ClearCollect(
    colMembers,
    ForAll(
        PowerBIIntegration.Data,
        With(
            { ib:   Coalesce(Value(ThisRecord.'IB & NS Points' & ""),0),
              mgr:  Coalesce(Value(ThisRecord.'Manager Sponsor Points' & ""),0),
              ncc:  Coalesce(Value(ThisRecord.'New CC Logo Points' & ""),0),
              cw:   Coalesce(Value(ThisRecord.'Cap Won Points' & ""),0),
              cr:   Coalesce(Value(ThisRecord.'Cap Requests' & ""),0),
              cust: Coalesce(Value(ThisRecord.'Customer Centricity Points' & ""),0),
              ipg:  Coalesce(Value(ThisRecord.'IP in GL points' & ""),0),
              cwp:  Coalesce(Value(ThisRecord.'Cap Won Points Pending' & ""),0),
              crp:  Coalesce(Value(ThisRecord.'Cap Requests Pending' & ""),0),
              ccp:  Coalesce(Value(ThisRecord.'Customer Centricity Points Pending' & ""),0) },
            {
                Name:          ThisRecord.Name & "",
                Crew:          Coalesce(Value(ThisRecord.Crew & ""),0),
                Email:         Lower(ThisRecord.'User Email' & ""),
                SponsorEmail:  Lower(ThisRecord.'Manager Sponsor Email' & ""),
                Sponsor:       ThisRecord.'Manager Sponsor' & "",
                IBNS:          ib,
                MgrPts:        mgr,
                NewCCLogo:     ncc,
                CapWon:        cw,
                CapReq:        cr,
                CustCent:      cust,
                IPgl:          ipg,
                MemberTotal:   ib + mgr + ncc + cw + cr + cust + ipg,
                MemberPending: cwp + crp + ccp
            }
        )
    )
);

// 2) crew aggregates + ranking --------------------------------------------
ClearCollect(
    colCrewAgg,
    AddColumns(
        GroupBy( colMembers, "Crew", "GroupData" ),
        "CrewTotal",   Sum( GroupData, MemberTotal ),
        "CrewPending", Sum( GroupData, MemberPending ),
        "CrewSize",    CountRows( GroupData )
    )
);
ClearCollect(
    colCrew,
    ForAll(
        Sequence( CountRows( colCrewAgg ) ),
        With(
            { row: Last( FirstN(
                       SortByColumns( colCrewAgg, "CrewTotal", SortOrder.Descending, "Crew", SortOrder.Ascending ),
                       Value )) },
            { Rank: Value, Crew: row.Crew, CrewName: "Crew " & row.Crew,
              CrewTotal: row.CrewTotal, CrewPending: row.CrewPending, CrewSize: row.CrewSize }
        )
    )
);
Set( varLeaderMax, Coalesce( First( colCrew ).CrewTotal, 1 ) );
ClearCollect( colCrewRest, Filter( colCrew, Rank >= 4 ) );

// 3) viewer role -----------------------------------------------------------
Set( varUserEmail, Lower( User().Email ) );
Set( varMemberRec,  LookUp( colMembers, Email = varUserEmail ) );
Set( varSponsorRec, LookUp( colMembers, SponsorEmail = varUserEmail ) );
Set( varRole,
    If( !IsBlank( varMemberRec.Name ), "member",
        If( !IsBlank( varSponsorRec.Name ), "sponsor", "spectator" ) ) );
Set( varMyCrew,    Switch( varRole, "member", varMemberRec.Crew, "sponsor", varSponsorRec.Crew, Blank() ) );
Set( varMyCrewTag, If( varRole = "sponsor", "YOU SPONSOR", "YOUR CREW" ) );
Set( varDispName,
    Switch( varRole, "member", varMemberRec.Name, "sponsor", varSponsorRec.Sponsor, "Guest Viewer" ) );
Set( varMyInitials,
    Upper( Left( varDispName, 1 ) & Mid( varDispName & " ", Find( " ", varDispName & " " ) + 1, 1 ) ) );
Set( varRibbonChip,
    Switch( varRole,
        "member",  varDispName & " · Crew " & varMyCrew,
        "sponsor", varDispName & " · Sponsor",
        "Guest Viewer · Spectator" ) );

// 4) per-crew category breakdown ------------------------------------------
ClearCollect(
    colCrewBreak,
    ForAll(
        Sort( colCrew, Rank ),
        With(
            { cnum: Crew, rk: Rank, cnm: CrewName, ct: CrewTotal, cp: CrewPending },
            With(
                { f: Filter( colMembers, Crew = cnum ) },
                { Rank: rk, Crew: cnum, CrewName: cnm, Total: ct, Pending: cp,
                  NewCC:  Sum( f, IBNS + NewCCLogo ),
                  CapEng: Sum( f, CapReq ),
                  CapOrd: Sum( f, CapWon ),
                  CC:     Sum( f, CustCent ),
                  Accred: Sum( f, MgrPts ),
                  IP:     Sum( f, IPgl ) }
            )
        )
    )
);

// 5) viewer's crew members (grid) -----------------------------------------
ClearCollect(
    colMyCrewSorted,
    SortByColumns( Filter( colMembers, Crew = varMyCrew ),
                   "MemberTotal", SortOrder.Descending, "Name", SortOrder.Ascending )
);
ClearCollect(
    colMyCrew,
    ForAll(
        Sequence( CountRows( colMyCrewSorted ) ),
        With( { row: Last( FirstN( colMyCrewSorted, Value ) ) },
            { Idx: Value - 1, Name: row.Name, MemberTotal: row.MemberTotal,
              IsMe: row.Email = varUserEmail } )
    )
);

// 6) left "box" values -----------------------------------------------------
Set( varCB, LookUp( colCrewBreak, Crew = varMyCrew ) );
Set( varBoxTitle,  If( varRole = "sponsor", "YOUR CREW", "YOUR PERFORMANCE" ) );
Set( varBoxName,   If( varRole = "sponsor", varCB.CrewName, varMemberRec.Name ) );
Set( varBoxSub,    If( varRole = "sponsor", "You sponsor · " & CountRows(colMyCrew) & " people", "Crew " & varMyCrew & " · You" ) );
Set( varBoxTotLbl, If( varRole = "sponsor", "CREW TOTAL · EXCL PENDING", "TOTAL · EXCL PENDING" ) );
Set( varBoxTotal,  If( varRole = "sponsor", varCB.Total,   varMemberRec.MemberTotal ) );
Set( varBoxPending,If( varRole = "sponsor", varCB.Pending, varMemberRec.MemberPending ) );
Set( varB1, If( varRole = "sponsor", varCB.NewCC,  varMemberRec.IBNS + varMemberRec.NewCCLogo ) );
Set( varB2, If( varRole = "sponsor", varCB.CapEng, varMemberRec.CapReq ) );
Set( varB3, If( varRole = "sponsor", varCB.CapOrd, varMemberRec.CapWon ) );
Set( varB4, If( varRole = "sponsor", varCB.CC,     varMemberRec.CustCent ) );
Set( varB5, If( varRole = "sponsor", varCB.Accred, varMemberRec.MgrPts ) );
Set( varB6, If( varRole = "sponsor", varCB.IP,     varMemberRec.IPgl ) );

// 7) shared SVG motion stylesheet -----------------------------------------
Set(
    varSvgCss,
    "<style>.fu{animation:fu .55s cubic-bezier(.2,.7,.2,1) both}.fo{animation:fo .5s ease-out both}.pp{animation:pp .5s cubic-bezier(.2,.7,.2,1) both;transform-box:fill-box;transform-origin:center}.gx{animation:gx .65s cubic-bezier(.2,.7,.2,1) both;transform-box:fill-box;transform-origin:left center}.rw{animation:rw .5s cubic-bezier(.2,.7,.2,1) both}.ring{transform-box:fill-box;transform-origin:center;animation:ring 2.8s ease-out infinite}.brz{animation:brz 2.6s ease-in-out infinite}@keyframes fu{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}@keyframes fo{from{opacity:0}to{opacity:1}}@keyframes pp{from{opacity:0;transform:scale(.5)}to{opacity:1;transform:scale(1)}}@keyframes gx{from{transform:scaleX(0)}to{transform:scaleX(1)}}@keyframes rw{from{opacity:0;transform:translateX(-18px)}to{opacity:1;transform:none}}@keyframes ring{0%{opacity:.45;transform:scale(.75)}70%{opacity:0;transform:scale(2)}100%{opacity:0;transform:scale(2)}}@keyframes brz{0%,100%{opacity:.9}50%{opacity:.45}}@media(prefers-reduced-motion:reduce){.fu,.fo,.pp,.gx,.rw,.ring,.brz,.scrl{animation:none}}</style>"
);

// 8) ready flag (drives the optional loading overlay) ---------------------
Set( varReady, CountRows( colMembers ) > 0 );
