// ============================================================================
//  Screen.OnVisible  —  thin trigger.
//  The data build lives in tmrLoad.OnTimerEnd (it must wait for
//  PowerBIIntegration.Data). Forcing varRowCount = -1 makes tmrLoad.Start
//  evaluate true, so a fresh build runs whenever this screen is (re)shown.
// ============================================================================
Set( varRowCount, -1 );
