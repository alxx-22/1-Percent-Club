// ============================================================================
//  Screen.OnVisible  —  thin trigger only.
//  The heavy data build lives in tmrLoad.OnTimerEnd, because it must wait for
//  PowerBIIntegration.Data to arrive (which is AFTER the screen first shows).
//  Clearing the signature + resetting the timer forces a fresh rebuild on the
//  next tick whenever this screen is shown or re-shown.
// ============================================================================
Set( varDataSig, "" );
Reset( tmrLoad );
