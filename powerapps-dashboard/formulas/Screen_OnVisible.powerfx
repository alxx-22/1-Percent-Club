// ============================================================================
//  Screen.OnVisible  —  BUILDS ALL DASHBOARD DATA.
//
//  CREW IS NOW A NAME (text), not a number. Teams submitted names, so:
//   - Crew is read as trimmed TEXT. (The old Value() coercion turned every
//     name into 0 and collapsed the whole board into a single "Crew 0".)
//   - Ranking: CrewTotal desc, ties alphabetical — done with ONE text SortKey,
//     because this environment rejects GroupBy/SortByColumns string args.
//   - CrewName is the name itself (no "Crew " prefix).
//   - Blank numeric point cells still throw on read -> IfError(pbi.col, 0).
// ============================================================================

// 1) members (typed + totals) ---------------------------------------------
ClearCollect(
    colMembers,
    ForAll(
        PowerBIIntegration.Data As pbi,
        With(
            { ib:   IfError(pbi.'IB & NS Points', 0),
              mgr:  IfError(pbi.'Manager Sponsor Points', 0),
              ncc:  IfError(pbi.'New CC Logo Points', 0),
              cw:   IfError(pbi.'Cap Won Points', 0),
              cr:   IfError(pbi.'Cap Requests', 0),
              cust: IfError(pbi.'Customer Centricity Points', 0),
              ipg:  IfError(pbi.'IP in GL points', 0),
              cwp:  IfError(pbi.'Cap Won Points Pending', 0),
              crp:  IfError(pbi.'Cap Requests Pending', 0),
              ccp:  IfError(pbi.'Customer Centricity Points Pending', 0),
              crw:  Trim(pbi.Crew & "") },
            {
                Name:          pbi.Name & "",
                Crew:          If(crw = "", "Unassigned", crw),
                // Job role for the Crew Portal cards — from the 'Job Family' column.
                // (Make sure 'Job Family' is in the PowerApps visual's data well.)
                Role:          pbi.'Job Family' & "",
                Email:         Lower(pbi.'User Email' & ""),
                SponsorEmail:  Lower(pbi.'Manager Sponsor Email' & ""),
                Sponsor:       pbi.'Manager Sponsor' & "",
                IBNS:          ib,
                MgrPts:        mgr,
                NewCCLogo:     ncc,
                CapWon:        cw,
                CapReq:        cr,
                CustCent:      cust,
                IPgl:          ipg,
                MemberTotal:   ib + mgr + ncc + cw + cr + cust + ipg,
                MemberPending: cwp + crp + ccp
            }
        )
    )
);

// 2) crew totals — one row per distinct crew NAME --------------------------
//    SortKey: bigger total => smaller key (sorts first ascending). The base is
//    fixed-width 8 digits so a 0-point crew (99999999) still sorts AFTER higher
//    totals (99999xxx) instead of before them. Equal totals fall back to name A-Z.
ClearCollect(
    colCrewAgg,
    ForAll(
        Distinct( colMembers, Crew ) As d,
        With(
            { f: Filter( colMembers, Crew = d.Value ) },
            With(
                { t: Sum( f, MemberTotal ) },
                { Crew:        d.Value,
                  CrewTotal:   t,
                  CrewPending: Sum( f, MemberPending ),
                  CrewSize:    CountRows( f ),
                  SortKey:     Text( 99999999 - t, "00000000" ) & Lower( d.Value ) }
            )
        )
    )
);

// 2b) rank them (ascending SortKey == total desc, name asc on ties) --------
ClearCollect(
    colCrew,
    ForAll(
        Sequence( CountRows( colCrewAgg ) ),
        With(
            { row: Last( FirstN( Sort( colCrewAgg, SortKey ), Value ) ) },
            { Rank:        Value,
              Crew:        row.Crew,
              CrewName:    row.Crew,
              CrewTotal:   row.CrewTotal,
              CrewPending: row.CrewPending,
              CrewSize:    row.CrewSize }
        )
    )
);
Set( varLeaderMax, Max( 1, Coalesce( First( colCrew ).CrewTotal, 0 ) ) );  // >=1 so bars never divide by a 0 leader
ClearCollect( colCrewRest, Filter( colCrew, Rank >= 4 ) );

// 3) viewer role  (varMyCrew is now the crew NAME) --------------------------
//    DIAGNOSTIC override: when varTestCrew is set ("" in production), impersonate
//    that crew's top member BY RECORD — works even if member emails are blank.
//    Production path is unchanged: detect the role from the signed-in user's email.
Set( varTestActive, Len( varTestCrew ) > 0 );
Set( varTestMember,
    If( varTestActive,
        First( Sort( Filter( colMembers, Crew = varTestCrew ), MemberTotal, SortOrder.Descending ) ),
        Blank() ) );
Set( varUserEmail,  If( varTestActive, Lower( varTestMember.Email ), Lower( User().Email ) ) );
Set( varMemberRec,  If( varTestActive, varTestMember, LookUp( colMembers, Email = varUserEmail ) ) );
Set( varSponsorRec, If( varTestActive, Blank(), LookUp( colMembers, SponsorEmail = varUserEmail ) ) );
Set( varRole,
    If( varTestActive, "member",
        If( !IsBlank( varMemberRec.Name ), "member",
            If( !IsBlank( varSponsorRec.Name ), "sponsor", "spectator" ) ) ) );
Set( varMyCrew,
    If( varTestActive, varTestCrew,
        Switch( varRole, "member", varMemberRec.Crew, "sponsor", varSponsorRec.Crew, Blank() ) ) );
Set( varMyCrewTag, If( varRole = "sponsor", "YOU SPONSOR", "YOUR CREW" ) );
Set( varDispName,
    Switch( varRole, "member", varMemberRec.Name, "sponsor", varSponsorRec.Sponsor, "Guest Viewer" ) );
Set( varMyInitials,
    Upper( Left( varDispName, 1 ) & Mid( varDispName & " ", Find( " ", varDispName & " " ) + 1, 1 ) ) );
Set( varRibbonChip,
    Switch( varRole,
        "member",  varDispName & " · " & varMyCrew,
        "sponsor", varDispName & " · Sponsor",
        "Guest Viewer · Spectator" ) );

// 4) per-crew category breakdown ------------------------------------------
ClearCollect(
    colCrewBreak,
    ForAll(
        Sort( colCrew, Rank ) As c,
        With(
            { f: Filter( colMembers, Crew = c.Crew ) },
            { Rank: c.Rank, Crew: c.Crew, CrewName: c.CrewName, Total: c.CrewTotal, Pending: c.CrewPending,
              NewCC:  Sum( f, IBNS + NewCCLogo ),
              CapEng: Sum( f, CapReq ),
              CapOrd: Sum( f, CapWon ),
              CC:     Sum( f, CustCent ),
              Accred: Sum( f, MgrPts ),
              IP:     Sum( f, IPgl ) }
        )
    )
);

// 5) viewer's crew members (grid), 0-based Idx ----------------------------
ClearCollect(
    colMyCrewSorted,
    Sort( Filter( colMembers, Crew = varMyCrew ), MemberTotal, SortOrder.Descending )
);
ClearCollect(
    colMyCrew,
    ForAll(
        Sequence( CountRows( colMyCrewSorted ) ),
        With( { row: Last( FirstN( colMyCrewSorted, Value ) ) },
            { Idx: Value - 1, Name: row.Name, Role: row.Role, MemberTotal: row.MemberTotal,
              IsMe: row.Email = varUserEmail } )
    )
);

// 6) left "box" values -----------------------------------------------------
Set( varCB, LookUp( colCrewBreak, Crew = varMyCrew ) );
Set( varBoxTitle,  If( varRole = "sponsor", "YOUR CREW", "YOUR PERFORMANCE" ) );
Set( varBoxName,   If( varRole = "sponsor", varCB.CrewName, varMemberRec.Name ) );
Set( varBoxSub,    If( varRole = "sponsor", "You sponsor · " & CountRows(colMyCrew) & " people", varMyCrew & " · You" ) );
Set( varBoxTotLbl, If( varRole = "sponsor", "CREW TOTAL · EXCL PENDING", "TOTAL · EXCL PENDING" ) );
Set( varBoxTotal,  If( varRole = "sponsor", varCB.Total,   varMemberRec.MemberTotal ) );
Set( varBoxPending,If( varRole = "sponsor", varCB.Pending, varMemberRec.MemberPending ) );
Set( varB1, If( varRole = "sponsor", varCB.NewCC,  varMemberRec.IBNS + varMemberRec.NewCCLogo ) );
Set( varB2, If( varRole = "sponsor", varCB.CapEng, varMemberRec.CapReq ) );
Set( varB3, If( varRole = "sponsor", varCB.CapOrd, varMemberRec.CapWon ) );
Set( varB4, If( varRole = "sponsor", varCB.CC,     varMemberRec.CustCent ) );
Set( varB5, If( varRole = "sponsor", varCB.Accred, varMemberRec.MgrPts ) );
Set( varB6, If( varRole = "sponsor", varCB.IP,     varMemberRec.IPgl ) );

// 7) shared SVG motion stylesheet -----------------------------------------
Set(
    varSvgCss,
    "<style>.fu{animation:fu .55s cubic-bezier(.2,.7,.2,1) both}.fo{animation:fo .5s ease-out both}.pp{animation:pp .5s cubic-bezier(.2,.7,.2,1) both;transform-box:fill-box;transform-origin:center}.gx{animation:gx .65s cubic-bezier(.2,.7,.2,1) both;transform-box:fill-box;transform-origin:left center}.rw{animation:rw .5s cubic-bezier(.2,.7,.2,1) both}.ring{transform-box:fill-box;transform-origin:center;animation:ring 2.8s ease-out infinite}.brz{animation:brz 2.6s ease-in-out infinite}.bob{transform-box:fill-box;transform-origin:center;animation:bob 2.4s ease-in-out infinite}@keyframes fu{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}@keyframes fo{from{opacity:0}to{opacity:1}}@keyframes pp{from{opacity:0;transform:scale(.5)}to{opacity:1;transform:scale(1)}}@keyframes gx{from{transform:scaleX(0)}to{transform:scaleX(1)}}@keyframes rw{from{opacity:0;transform:translateX(-18px)}to{opacity:1;transform:none}}@keyframes ring{0%{opacity:.45;transform:scale(.75)}70%{opacity:0;transform:scale(2)}100%{opacity:0;transform:scale(2)}}@keyframes brz{0%,100%{opacity:.9}50%{opacity:.45}}@keyframes bob{0%,100%{transform:translateY(0) rotate(-4deg)}50%{transform:translateY(-2px) rotate(4deg)}}@media(prefers-reduced-motion:reduce){.fu,.fo,.pp,.gx,.rw,.ring,.brz,.scrl,.bob{animation:none}}</style>"
);

// 8) ready flag (drives the optional loading overlay) ---------------------
Set( varReady, CountRows( colMembers ) > 0 );
