// ============================================================================
//  scrLogMeeting.OnVisible  -  Log a customer meeting (Customer Centricity).
//
//  DATA SOURCE: the approvals SharePoint list, added via Data > Add data.
//  Referenced below as '1 Percent Approvals' - if your list's display name
//  differs, change it here, in btnMeetSave, and in galMeetMine.Items.
//  (A name containing spaces MUST stay single-quoted in Power Fx.)
//
//  HOW A MEETING SCORES (mirrors the Customer Centricity measures, which
//  now read this list - see Customer_Centricity_Points.dax):
//    1. 'Approval Type' must be EXACTLY one of the list's choices. The
//       measures match on that string: F2F Meeting 35, Leadership Meeting
//       20, Customer Meeting 10, Channel Partner Meeting 10.
//    2. 'Requestor Name' must hold the logger's dashboard name - that is
//       what the measures join on, so points find the right person.
//    3. 'Approval Status' = "Approve" scores; BLANK = pending. The L1
//       manager signs it off.
//  The dropdown labels ARE the Approval Type values, so there is no
//  mapping layer to drift out of step with the choice column.
// ============================================================================

// 1) the meeting types -------------------------------------------------------
//    The four choices live in drpMeetSubject.Items; their awards live in the
//    Switch used by imgMeetForm and imgMeetScore. FOUR PLACES must agree on
//    these exact strings, or a meeting silently scores nothing:
//      drpMeetSubject.Items - the Switch - the SharePoint 'Approval Type'
//      choice column - the Customer Centricity measures.
//        F2F Meeting 35 | Leadership Meeting 20 | Customer Meeting 10 |
//        Channel Partner Meeting 10

// 2) who is logging, and who approves it -------------------------------------
//    Credit is by NAME, so varMeetMyName is what gets written. The approver is
//    the logger's L1 manager, read straight off the model row for this user.
Set( varMeetMyEmail, Trim( Lower( varUserEmail ) ) );
With(
    { me: LookUp( PowerBIIntegration.Data, Trim( Lower( 'User Email' & "" ) ) = varMeetMyEmail ) },
    Set( varMeetMyName, me.Name & "" );
    Set( varMeetApprover, Trim( Lower( me.'L1 Manager Email' & "" ) ) );
    Set( varMeetIsEligible,
Trim( me.'S Coded?' & "" ) = "Non S-Coded (Phil)"
// TESTING: lets the programme owner use the screen even though their
// record is S-Coded. Uses the REAL signed-in email (varUserEmail is
// remapped for some accounts). Delete this line for production.
|| Lower( User().Email ) = "alex.cohen@hpe.com" )
);

// 3) what I have logged already (newest first) -------------------------------
Set( varMeetSaved, false );
ClearCollect(
    colMeetMine,
    ForAll(
        Filter( '1 Percent Approvals', 'Requestor Name' = varMeetMyName ) As r,
        {
            MAccount:  r.'Account Name' & "",
            MSubject:  r.'Approval Type' & "",
            MStatus:   If( IsBlank( r.'Approval Status' & "" ), "Pending", r.'Approval Status' & "" )
        }
    )
)
