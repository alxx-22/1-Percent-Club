-- ============================================================================
--  Customer Centricity Points  /  ...Points Pending   (Teams calculated columns)
--
--  CHANGED: these now read the SharePoint approvals list '1 Percent Approvals'
--  instead of 'Customer Meetings', join on [Requestor Name], and classify on
--  [Approval Type].
--
--  AWARD:  F2F 35  ·  Leadership 20  ·  Customer 10  ·  Channel Partner 10
--  APPROVED  = [Approval Status] = "Approve"      -> Customer Centricity Points
--  PENDING   = [Approval Status] = BLANK()        -> ...Points Pending
--
--  >>> F2F VALUE <<<  "F2F Meeting" is the exact string the model's Meeting Type
--  SWITCH produces (see Meeting_Type.dax) and the exact string the app writes into
--  Approval Type. "Face-to-Face Meeting" - which the previous version of these
--  measures looked for - is never produced by anything, so it scored ZERO.
-- ============================================================================

Customer Centricity Points =
VAR thisuser = Teams[Name]
VAR f2f =
    COUNTROWS (
        FILTER (
            '1 Percent Approvals',
            '1 Percent Approvals'[Requestor Name] = thisuser
                && '1 Percent Approvals'[Approval Type] IN { "F2F Meeting" }
                && '1 Percent Approvals'[Approval Status] = "Approve"
        )
    ) * 35
VAR customerchannel =
    COUNTROWS (
        FILTER (
            '1 Percent Approvals',
            '1 Percent Approvals'[Requestor Name] = thisuser
                && '1 Percent Approvals'[Approval Type] IN { "Customer Meeting", "Channel Partner Meeting" }
                && '1 Percent Approvals'[Approval Status] = "Approve"
        )
    ) * 10
VAR leadership =
    COUNTROWS (
        FILTER (
            '1 Percent Approvals',
            '1 Percent Approvals'[Requestor Name] = thisuser
                && '1 Percent Approvals'[Approval Type] IN { "Leadership Meeting" }
                && '1 Percent Approvals'[Approval Status] = "Approve"
        )
    ) * 20
RETURN
    IF ( leadership + customerchannel + f2f = BLANK (), 0, leadership + customerchannel + f2f )


-- ----------------------------------------------------------------------------

Customer Centricity Points Pending =
VAR thisuser = Teams[Name]
VAR f2f =
    COUNTROWS (
        FILTER (
            '1 Percent Approvals',
            '1 Percent Approvals'[Requestor Name] = thisuser
                && '1 Percent Approvals'[Approval Type] IN { "F2F Meeting" }
                && '1 Percent Approvals'[Approval Status] = BLANK ()
        )
    ) * 35
VAR customerchannel =
    COUNTROWS (
        FILTER (
            '1 Percent Approvals',
            '1 Percent Approvals'[Requestor Name] = thisuser
                && '1 Percent Approvals'[Approval Type] IN { "Customer Meeting", "Channel Partner Meeting" }
                && '1 Percent Approvals'[Approval Status] = BLANK ()
        )
    ) * 10
VAR leadership =
    COUNTROWS (
        FILTER (
            '1 Percent Approvals',
            '1 Percent Approvals'[Requestor Name] = thisuser
                && '1 Percent Approvals'[Approval Type] IN { "Leadership Meeting" }
                && '1 Percent Approvals'[Approval Status] = BLANK ()
        )
    ) * 20
RETURN
    IF ( leadership + customerchannel + f2f = BLANK (), 0, leadership + customerchannel + f2f )
