// ============================================================================
//  lblDebug.Text  —  add a Label "lblDebug", paste this into its Text.
//  Label props:  Wrap = true,  AutoHeight = true,  Size = 11,
//                Fill = White,  Color = Red,  X = 16, Y = 70, Width = 700.
//  (Put it on the same screen as the dashboard so it sees the same vars.)
// ============================================================================
"rows in PowerBIIntegration.Data = " & CountRows( PowerBIIntegration.Data ) & Char(10) &
"colMembers = " & CountRows( colMembers ) & "    colCrew = " & CountRows( colCrew ) & Char(10) &
"colMyCrew = " & CountRows( colMyCrew ) & "    colCrewBreak = " & CountRows( colCrewBreak ) & Char(10) &
"varReady = " & varReady & "    varRole = " & varRole & Char(10) &
"varMyCrew = " & varMyCrew & "    varDispName = " & varDispName & Char(10) &
"viewer User().Email = " & Lower( User().Email )
