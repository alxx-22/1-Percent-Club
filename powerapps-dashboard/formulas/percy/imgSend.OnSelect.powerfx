// ============================================================================
//  imgSend.OnSelect — send the question.  NO PREMIUM: SharePoint Create + poll.
//
//  Creates a NEW PercyConversations item on every send (so the flow's
//  "When an item is created" trigger fires each time). Each item carries the
//  WHOLE conversation so far as JSON, so the agent always has full context.
//  The flow fills AnswerText + sets Status "Answered"; tmrPercyPoll watches
//  THIS item (by ID) and shows the reply.
//
//  LIST = PercyConversations (standard SharePoint connector, no premium).
//  (txtChat = chat TextInput;  galChat.Items = Sort(colChat, Seq).)
// ============================================================================
If(
    !IsBlank(Trim(txtChat.Text)) && !varPercyThinking,

    // 1) Show the user's message immediately
    Set(varPercyQ, Trim(txtChat.Text));

    Collect(
        colChat,
        {
            Seq: CountRows(colChat) + 1,
            Role: "user",
            Body: varPercyQ
        }
    );

    Reset(txtChat);

    // 2) Build JSON for the whole conversation
    Set(
        varChatJson,
        JSON(
            ShowColumns(
                colChat,
                Seq,
                Role,
                Body
            )
        )
    );

    // 3) Create a NEW SharePoint item every time
    Set(
        varAsk,
        Patch(
            PercyConversations,
            Defaults(PercyConversations),
            {
                Title: Text(varSessionId) & " - " & Text(Now(), "yyyymmddhhmmss"),
                SessionId: Text(varSessionId),
                ConversationJson: varChatJson,
                UserEmail: Lower(User().Email),
                LastQuestion: varPercyQ,
                MessageCount: CountRows(colChat),
                AnswerText: "",
                Status: "Pending"
            }
        )
    );

    // 4) Save the new SharePoint item ID for polling
    Set(varAskId, varAsk.ID);

    // 5) Start polling timer
    Set(varPollN, 0);
    Set(varThinkOut, false);
    Set(varPercyThinking, true)
)
