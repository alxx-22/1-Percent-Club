// ============================================================================
//  imgSend.OnSelect  —  send the question.  NO PREMIUM: SharePoint Patch + poll.
//
//  Creates a NEW row in the "PercyConversations" list on every send (one row
//  per message). Each row carries the WHOLE conversation so far as JSON, so the
//  agent always has full context; the answer starts empty and Status "Pending".
//  A SharePoint-triggered flow ("when an item is created") fills AnswerText +
//  sets "Answered"; tmrPercyPoll watches THIS row (by ID) and shows the reply.
//  (New-row-per-send lets the flow trigger on create only — the write-back is a
//   modify it ignores, so it never re-triggers itself. No loop guard needed.)
//
//  LIST = PercyConversations (add it as a data source — standard SharePoint
//  connector, no premium). Columns: Title, SessionId, ConversationJson,
//  UserEmail, LastQuestion, MessageCount  PLUS two you add:  Status (text),
//  AnswerText (multi-line).  See backend/README.md.
//  (txtChat = chat TextInput;  galChat.Items = Sort(colChat, Seq).)
// ============================================================================
If(
    !IsBlank( Trim( txtChat.Text ) ) && !varPercyThinking,

    // 1) show the user's message immediately
    Set( varPercyQ, Trim( txtChat.Text ) );
    Collect( colChat, { Seq: CountRows(colChat) + 1, Role: "user", Body: varPercyQ } );
    Reset( txtChat );

    // 2) create a NEW row for this send (whole conversation as JSON for AI context)
    Set( varChatJson, JSON( ShowColumns( colChat, "Seq", "Role", "Body" ) ) );
    Set( varAsk,
        Patch( PercyConversations,
            Defaults( PercyConversations ),
            { Title:            varSessionId,
              SessionId:        varSessionId,
              ConversationJson: varChatJson,
              UserEmail:        Lower( User().Email ),
              LastQuestion:     varPercyQ,
              MessageCount:     CountRows( colChat ),
              AnswerText:       "",
              Status:           "Pending" } ) );
    Set( varAskId, varAsk.ID );

    // 3) wait for the flow's reply (tmrPercyPoll polls while varPercyThinking;
    //    imgThinking shows "Percy is thinking/typing…")
    Set( varThinkOut, false );    // clean state so the indicator plays its entrance
    Set( varPollN, 0 );
    Set( varPercyThinking, true )
)
