// ============================================================================
//  imgSend.OnSelect  —  send the question.  NO PREMIUM: SharePoint Patch + poll.
//
//  Flow:  add the user's message to colChat -> Patch a NEW row into the
//  "PercyMessages" SharePoint list (Status "Pending") carrying the whole
//  conversation as JSON -> flip varPercyThinking on.  A SharePoint‑triggered
//  flow ("when an item is created or modified") fills AnswerText + sets Status
//  "Answered"; tmrPercyPoll watches for that and shows Percy's reply.
//
//  REQUIRES the "PercyMessages" list added as a data source (standard SharePoint
//  connector — no premium). Columns in backend/README.md.
//  (txtChat = chat TextInput;  galChat.Items = Sort(colChat, Seq).)
// ============================================================================
If(
    !IsBlank( Trim( txtChat.Text ) ) && !varPercyThinking,    // ignore empty + while waiting

    // 1) show the user's message immediately
    Set( varPercyQ, Trim( txtChat.Text ) );
    Collect( colChat, { Seq: CountRows(colChat) + 1, Role: "user", Body: varPercyQ } );
    Reset( txtChat );

    // 2) write it to SharePoint (the whole conversation as JSON for AI context)
    Set( varChatJson, JSON( ShowColumns( colChat, "Seq", "Role", "Body" ) ) );
    Set( varAsk,
        Patch( PercyMessages, Defaults( PercyMessages ),
            { Title:            varSessionId,
              SessionId:        varSessionId,
              Question:         varPercyQ,
              ConversationJson: varChatJson,
              AnswerText:       "",
              Status:           "Pending" } ) );
    Set( varAskId, varAsk.ID );

    // 3) wait for the flow's reply (tmrPercyPoll polls while varPercyThinking)
    Set( varPollN, 0 );
    Set( varPercyThinking, true )
)
