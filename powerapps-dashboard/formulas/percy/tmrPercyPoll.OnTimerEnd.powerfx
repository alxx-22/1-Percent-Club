// ============================================================================
//  tmrPercyPoll.OnTimerEnd  —  watch SharePoint for the flow's answer.
//
//  PLACEMENT: a Timer "tmrPercyPoll" inside conPercyChat:
//    Duration = 2000           (poll every 2s)
//    Repeat   = true
//    AutoStart= false
//    Start    = varPercyThinking      <-- runs only while awaiting a reply
//    Reset    = !varPercyThinking
//    Visible  = false
//
//  Each tick: refresh the list, re-read the row we created (by ID). When the
//  flow has written AnswerText / set Status "Answered", show Percy's reply and
//  stop. Gives up after ~30s (15 x 2s) so it never polls forever.
//  (No ";" inside any If branch — each If runs a single function — to stay
//   compatible with all Power Fx versions.)
// ============================================================================
Set( varPollN, varPollN + 1 );
Refresh( PercyMessages );
Set( varPercyRow, LookUp( PercyMessages, ID = varAskId ) );
Set( varGotReply, varPercyRow.Status = "Answered" || !IsBlank( varPercyRow.AnswerText ) );

If( varGotReply,
    Collect( colChat, { Seq: CountRows(colChat) + 1, Role: "percy", Body: varPercyRow.AnswerText } ) );

If( !varGotReply && varPollN >= 15,
    Collect( colChat, { Seq: CountRows(colChat) + 1, Role: "percy",
        Body: "Sorry, I couldn't reach the assistant just now — please try again." } ) );

If( varGotReply || varPollN >= 15,
    Set( varPercyThinking, false ) )
