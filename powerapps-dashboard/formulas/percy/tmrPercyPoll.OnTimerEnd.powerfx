// ============================================================================
//  tmrPercyPoll.OnTimerEnd  —  watch PercyConversations for the flow's answer.
//
//  PLACEMENT: a Timer "tmrPercyPoll" inside conPercyChat:
//    Duration = 2000           (poll every 2s)
//    Repeat   = true
//    AutoStart= false
//    Start    = varPercyThinking      <-- runs only while awaiting a reply
//    Reset    = !varPercyThinking
//    Visible  = false
//
//  ⏱ TIMEOUT lives HERE: total wait = tmrPercyPoll.Duration x varPollMax.
//     varPollMax is set in App.OnStart (default 120 -> 120 x 2000ms = 240s).
//     SharePoint's "when an item is created" trigger can take 30-60s+ to FIRE,
//     so keep this generous. To wait longer: raise varPollMax (App.OnStart)
//     and/or the timer's Duration. To wait shorter: lower them.
//
//  Each tick: refresh the list, re-read this session's row (by ID). The send
//  button cleared AnswerText + set Status "Pending", so a reply is ready only
//  when Status is "Answered" AND AnswerText is non-blank. Show it and stop.
// ============================================================================
Set( varPollN, varPollN + 1 );
Refresh( PercyConversations );
Set( varPercyRow, LookUp( PercyConversations, ID = varAskId ) );
// GUARD with varPercyThinking: once we collect the reply we set it false, so any
// extra timer ticks evaluate varGotReply/varDone as false and do nothing — the
// answer is added to colChat exactly once (no duplicate bubbles).
Set( varGotReply, varPercyThinking && varPercyRow.Status = "Answered" && !IsBlank( varPercyRow.AnswerText ) );
Set( varDone, varPercyThinking && ( varGotReply || varPollN >= varPollMax ) );

If( varGotReply,
    Collect( colChat, { Seq: CountRows(colChat) + 1, Role: "percy", Body: varPercyRow.AnswerText } ) );

If( varDone && !varGotReply,
    Collect( colChat, { Seq: CountRows(colChat) + 1, Role: "percy",
        Body: "Sorry, I couldn't reach the assistant just now — please try again." } ) );

If( varDone, Set( varThinkOut, true ) );        // play the thinking indicator's exit animation
If( varDone, Set( varPercyThinking, false ) )    // stop polling; tmrThinkHide hides the indicator after the exit
