// ============================================================================
//  SEND BUTTON (SVG).  Control: Image "imgSend"
//  Geometry (over the chat input band, right end):
//        X=container.X+312  Y=container.Y+470  Width=40  Height=40
//        ImagePosition=Fit   OnSelect = imgSend.OnSelect.powerfx
//  Animates IN/OUT in sync with imgChatBg + imgClose — same vars (varChatClosing
//  keyed by varChatKey via <desc>): 'cin' on open, 'cout' on close. Because it
//  animates away, leave imgSend.Visible at its default (do NOT set !varChatClosing).
//  A brand-green circle with a paper-plane glyph.
// ============================================================================
"data:image/svg+xml;utf8," & EncodeUrl(
    "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 44 44'>" &
    "<desc>" & Text(varChatKey) & If(varChatClosing,"-out","-in") & "</desc>" &
    "<style>" &
    ".cin{transform-box:fill-box;transform-origin:center;animation:cin .42s cubic-bezier(.2,.8,.2,1) both}@keyframes cin{from{opacity:0;transform:scale(.4)}to{opacity:1;transform:none}}" &
    ".cout{transform-box:fill-box;transform-origin:center;animation:cout .34s ease-in both}@keyframes cout{from{opacity:1;transform:none}to{opacity:0;transform:scale(.4)}}" &
    "@media(prefers-reduced-motion:reduce){.cin,.cout{animation:none}}" &
    "</style>" &
    "<g class='" & If(varChatClosing,"cout","cin") & "'>" &
    "<circle cx='22' cy='22' r='21' fill='#01a982'/>" &
    "<path d='M33,22 L12,13 L17,22 L12,31 Z' fill='#ffffff'/>" &
    "<path d='M17,22 L33,22 L12,31 Z' fill='#d1ffee'/>" &
    "</g>" &
    "</svg>"
)
