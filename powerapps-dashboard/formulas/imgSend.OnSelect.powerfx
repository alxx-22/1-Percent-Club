// ============================================================================
//  imgSend.OnSelect  —  send the typed question to Percy.
//  Appends the user's message to colChat, then asks the AI. The Power Automate
//  call is stubbed (you'll wire it up later — see PERCY.md); a temporary canned
//  reply is collected so the UI is fully testable now.
//  (txtChat = the chat TextInput;  galChat.Items = Sort(colChat, Seq).)
// ============================================================================
If(
    !IsBlank( Trim( txtChat.Text ) ),

    // 1) show the user's message immediately
    Collect( colChat, { Seq: CountRows(colChat) + 1, Role: "user", Body: txtChat.Text } );
    Set( varPercyQ, txtChat.Text );
    Reset( txtChat );
    Set( varPercyThinking, true );

    // 2) ask Percy --------------------------------------------------------
    //    WIRE UP LATER (PowerApps V2 flow that calls your AI + SharePoint):
    //
    //    Set( varPercyA,
    //         PercyAsk.Run( varPercyQ, varSessionId ).answer );
    //    Collect( colChat, { Seq: CountRows(colChat) + 1, Role: "percy", Body: varPercyA } );
    //
    //    --- TEMPORARY echo so you can test the UI before the flow exists: ---
    Collect( colChat,
        { Seq: CountRows(colChat) + 1, Role: "percy",
          Body: "Got it — connect the PercyAsk flow (see PERCY.md) and I'll answer ""(" & varPercyQ & ")"" for real." } );

    Set( varPercyThinking, false )
)
