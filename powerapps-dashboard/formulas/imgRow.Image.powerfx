// ============================================================================
//  LEADERBOARD ROW — ranks 4..10 (GALLERY template).
//  Gallery "galLeaderboard":  Items = colCrewRest
//        X=452  Y=412  Width=668  Height=212   TemplateSize=30  TemplatePadding=0
//  Inside template, Image "imgRow":  X=0 Y=0  Width=Parent.TemplateWidth
//        Height=Parent.TemplateHeight  ImagePosition=Fit  Image = (below)
//  The viewer's crew row is tinted + flagged (varMyCrew / varMyCrewTag).
// ============================================================================
"data:image/svg+xml;utf8," & EncodeUrl(
    "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 668 30' font-family='Segoe UI, Arial, sans-serif'>" & varSvgCss &
    "<g class='rw' style='animation-delay:" & Text( Max( 0, (ThisItem.Rank-4)*80 ) ) & "ms'>" &
    With(
        { m: !IsBlank(varMyCrew) && ThisItem.Crew = varMyCrew },
        "<rect x='2' y='2' width='664' height='26' rx='8' fill='" & If(m,"#d1ffee","#ffffff") & "' stroke='" & If(m,"#01a982","#d4d8db") & "' stroke-width='" & If(m,"2","1") & "'/>" &
        If( m, "<rect x='2' y='2' width='5' height='26' rx='2.5' fill='#01a982'/>", "" ) &
        "<rect x='10' y='5' width='20' height='20' rx='6' fill='" & If(m,"#01a982","#f2f3f4") & "'/>" &
        "<text x='20' y='15' font-size='11' font-weight='700' fill='" & If(m,"#ffffff","#292d3a") & "' text-anchor='middle' dominant-baseline='central'>" & Text(ThisItem.Rank) & "</text>" &
        "<text x='40' y='19' font-size='13' font-weight='700' fill='" & If(m,"#006750","#292d3a") & "'>" & ThisItem.CrewName & "</text>" &
        If( m,
            "<rect x='" & Text(40 + Len(ThisItem.CrewName)*7 + 8) & "' y='8' width='" & Text(7*Len(varMyCrewTag)+16) & "' height='14' rx='7' fill='#d1ffee' stroke='#01a982'/>" &
            "<text x='" & Text(40 + Len(ThisItem.CrewName)*7 + 8 + (7*Len(varMyCrewTag)+16)/2) & "' y='15' font-size='8.5' font-weight='700' letter-spacing='.3' fill='#006750' text-anchor='middle' dominant-baseline='central'>" & varMyCrewTag & "</text>",
            "" )
    ) &
    // ---- progress = a ship sailing a wave (water fills, ship rides the leading edge) ----
    With(
        { d:  Max( 0, (ThisItem.Rank-4)*80 ),
          fw: Round( Max( 4, 358 * ThisItem.CrewTotal / Max( varLeaderMax, 1 ) ), 0 ) },
        "<rect x='190' y='15' width='358' height='7' rx='3.5' fill='#eef1f3'/>" &
        "<rect x='190' y='15' width='" & Text(fw) & "' height='7' rx='3.5' fill='#01a982' class='gx' style='animation-delay:" & Text(d+250) & "ms'/>" &
        "<g class='fo' style='animation-delay:" & Text(d+500) & "ms' transform='translate(" & Text(190+fw) & ",15)'>" &
        "<path d='M-12,5 q3,-3 6,0 t6,0 t6,0' fill='none' stroke='#ffffff' stroke-width='1.4' opacity='.7'/>" &
        "<g class='bob'>" &
        "<path d='M-8,-1 L8,-1 L5,4 L-5,4 Z' fill='#292d3a'/>" &
        "<line x1='0' y1='-1' x2='0' y2='-12' stroke='#292d3a' stroke-width='1.4'/>" &
        "<path d='M1.5,-11 L7,-2 L1.5,-2 Z' fill='#ffffff' stroke='#b1b9be' stroke-width='.5'/>" &
        "<path d='M-1.5,-9 L-5.5,-2 L-1.5,-2 Z' fill='#ffffff' stroke='#b1b9be' stroke-width='.5'/>" &
        "<path d='M0,-12 L4,-11 L0,-10 Z' fill='#01a982'/>" &
        "</g></g>"
    ) &
    "<text x='598' y='20' font-size='16' font-weight='700' fill='#292d3a' text-anchor='end'>" & Text(ThisItem.CrewTotal) & "</text>" &
    "<text x='602' y='20' font-size='10' font-weight='600' fill='#606a70'>pts</text>" &
    If( ThisItem.CrewPending > 0,
        "<text x='658' y='20' font-size='10' font-weight='600' fill='#d36d00' text-anchor='end'>+" & Text(ThisItem.CrewPending) & "</text>",
        "" ) &
    "</g>" &
    "</svg>"
)
