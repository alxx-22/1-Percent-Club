// ============================================================================
//  imgCareCallsBtn.Image  -  the "Customer Care Calls" button on the Crew Portal.
//  Green primary pill. An Image is tappable, so the nav lives on OnSelect and the
//  access gate on Visible (see the sibling .powerfx files).
// ============================================================================
"data:image/svg+xml;utf8," & EncodeUrl(
    "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 200 30' font-family='Segoe UI, Arial, sans-serif'>" & varSvgCss &
    "<g class='fu'>" &
    "<rect x='1' y='1' width='198' height='28' rx='14' fill='#01a982' stroke='#01a982'/>" &
    "<circle cx='20' cy='15' r='9' fill='#ffffff' opacity='0.18'/>" &
    "<text x='20' y='16' font-size='9' font-weight='700' fill='#ffffff' text-anchor='middle' dominant-baseline='central'>CC</text>" &
    "<text x='38' y='16' font-size='12.5' font-weight='700' fill='#ffffff' dominant-baseline='central'>Customer Care Calls</text>" &
    "</g>" &
    "</svg>"
)
