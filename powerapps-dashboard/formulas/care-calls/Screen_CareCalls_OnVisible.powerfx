// ============================================================================
//  scrCareCalls.OnVisible  -  Customer Care Calls (post-renewal questionnaire).
//
//  DATA SOURCE: the SharePoint list 'HPE Services Post Renewal Questionnaire'
//  must be added to the app (Data > Add data). If your list is named
//  differently, rename it here and in btnCareSave / btnCareNoContact.
//
//  Builds, in order:
//    colCareDone     one row per opportunity already actioned (surveyed OR
//                    cleared by the rep) - these drop off the list.
//    colCareRaw      the crew's 'Care Call Pack' unpacked (rows "||", cols "//"):
//                    Status // OppId // OppName // Account // Fcst //
//                    Close(yyyy-mm-dd) // Val // OwnerName // Update.
//    colCareCallers  the NON S-CODED people in this crew - the callers.
//    colCareReps     the distinct aligned reps on those opps, indexed A-Z.
//    colCareOpps     each opp + the caller it is aligned to.
//
//  ALIGNMENT RULE: every opportunity belonging to the same sales rep goes to
//  the SAME non-S-coded caller (so one caller builds one relationship), and
//  reps are dealt round-robin across the callers, so the callers end up with
//  a similar number of opportunities. Deterministic: both lists are sorted,
//  so the same input always produces the same allocation.
// ============================================================================
Set( varCareOpp, Blank() );
Set( varCareStep, 1 );

// 1) what has already been answered or cleared -------------------------------
//    (small list; if it ever passes 500 rows raise the app's data row limit)
ClearCollect(
    colCareDone,
    ForAll( 'HPE Services Post Renewal Questionnaire' As q, { OppKey: q.Opportunity & "" } )
);

// 2) unpack the crew's Care Call Pack ----------------------------------------
Clear( colCareRaw );
With(
    { crewLine:
        First(
            Filter(
                PowerBIIntegration.Data,
                Trim( Lower( Crew & "" ) ) = Trim( Lower( varMyCrew & "" ) )
            )
        )
    },
    With(
        { pack: crewLine.'Care Call Pack' },
        If(
            !IsBlank( pack ),
            ForAll(
                Filter( Split( pack, "||" ), !IsBlank( Trim( Value ) ) ) As Row,
                With(
                    { cols: Split( Row.Value, "//" ) },
                    Collect(
                        colCareRaw,
                        {
                            Status:           Index( cols, 1 ).Value,
                            OppId:            Index( cols, 2 ).Value,
                            OppName:          Index( cols, 3 ).Value,
                            AccountName:      Index( cols, 4 ).Value,
                            ForecastCategory: Index( cols, 5 ).Value,
                            CloseDate:        Index( cols, 6 ).Value,
                            TotalValue:       Value( Index( cols, 7 ).Value ),
                            OwnerName:        Index( cols, 8 ).Value,
                            OppUpdate:        Index( cols, 9 ).Value
                        }
                    )
                )
            )
        )
    )
);

// 3) the callers: NON S-coded people in this crew, alphabetical for stability -
ClearCollect(
    colCareCallers,
    Sort(
        ForAll(
            Filter(
                PowerBIIntegration.Data,
                Trim( Lower( Crew & "" ) ) = Trim( Lower( varMyCrew & "" ) ),
                Trim( 'S Coded?' & "" ) = "Non S-Coded (Phil)"
            ) As t,
            { CallerName: t.Name & "", CallerEmail: Trim( Lower( t.'User Email' & "" ) ) }
        ),
        CallerEmail
    )
);
ClearCollect(
    colCareCallerIdx,
    ForAll(
        Sequence( CountRows( colCareCallers ) ) As s,
        With(
            { c: Last( FirstN( colCareCallers, s.Value ) ) },
            { Idx: s.Value - 1, CallerName: c.CallerName, CallerEmail: c.CallerEmail }
        )
    )
);
Set( varCareCallerCount, CountRows( colCareCallerIdx ) );

// 4) the aligned reps on those opps, indexed A-Z ------------------------------
ClearCollect(
    colCareReps,
    ForAll(
        Sequence( CountRows( Distinct( colCareRaw, OwnerName ) ) ) As s,
        With(
            { rp: Last( FirstN( Sort( Distinct( colCareRaw, OwnerName ), Value ), s.Value ) ).Value },
            { RepIdx: s.Value - 1, RepName: rp }
        )
    )
);

// 5) deal each rep's opportunities to a caller (round-robin over the reps) ----
ClearCollect(
    colCareOpps,
    ForAll(
        colCareRaw As o,
        With(
            { asg:
                If( varCareCallerCount > 0,
                    LookUp(
                        colCareCallerIdx,
                        Idx = Mod(
                            Coalesce( LookUp( colCareReps, RepName = o.OwnerName, RepIdx ), 0 ),
                            varCareCallerCount
                        )
                    )
                )
            },
            {
                Status:           o.Status,
                OppId:            o.OppId,
                OppName:          o.OppName,
                AccountName:      o.AccountName,
                ForecastCategory: o.ForecastCategory,
                CloseDate:        o.CloseDate,
                TotalValue:       o.TotalValue,
                OwnerName:        o.OwnerName,
                OppUpdate:        o.OppUpdate,
                AssignedName:     asg.CallerName,
                AssignedEmail:    asg.CallerEmail
            }
        )
    )
);

// 6) am I one of the callers? (if not - e.g. a tester - show the whole crew) --
Set( varCareMyEmail, Trim( Lower( varUserEmail ) ) );
Set( varCareIsCaller, !IsBlank( LookUp( colCareCallerIdx, CallerEmail = varCareMyEmail ) ) )
