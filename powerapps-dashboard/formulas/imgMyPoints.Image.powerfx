// ============================================================================
//  MY POINTS / CREW SUMMARY (NON-gallery).  Control: Image "imgMyPoints"
//  Geometry: X=16  Y=68  Width=420  Height=300   ImagePosition=Fit
//  Visible:  varRole <> "spectator"
//  Driven by OnVisible vars: member shows personal points, sponsor shows the
//  sponsored crew's summary (same layout, different values/labels).
//
//  Category re-labels: New CC Logo / IB Upsell (IB&NS + New CC Logo) ·
//  CAP Engagement (Cap Requests) · CAP Orders Booked (Cap Won) ·
//  Customer Centricity · Accreditation Race (Manager Sponsor) · IP Push (IP in GL)
// ============================================================================
"data:image/svg+xml;utf8," & EncodeUrl(
    "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 420 300' font-family='Segoe UI, Arial, sans-serif'>" & varSvgCss &
    "<text x='4' y='16' font-size='11' font-weight='700' letter-spacing='1.2' fill='#606a70'>" & varBoxTitle & "</text>" &
    "<g class='fu'>" &
    "<rect x='2' y='24' width='416' height='272' rx='14' fill='#ffffff' stroke='#d4d8db'/>" &
    "<circle cx='38' cy='60' r='18' fill='none' stroke='#01a982' stroke-width='2' class='ring' opacity='0'/>" &
    "<g class='pp' style='animation-delay:120ms'>" &
    "<circle cx='38' cy='60' r='18' fill='#01a982'/>" &
    "<text x='38' y='61' font-size='14' font-weight='700' fill='#ffffff' text-anchor='middle' dominant-baseline='central'>" & varMyInitials & "</text>" &
    "</g>" &
    "<text x='64' y='55' font-size='15' font-weight='700' fill='#292d3a'>" & Substitute(Substitute(Substitute(varBoxName,"&","&amp;"),"<","&lt;"),">","&gt;") & "</text>" &
    "<text x='64' y='72' font-size='11.5' fill='#606a70'>" & Substitute(Substitute(Substitute(varBoxSub,"&","&amp;"),"<","&lt;"),">","&gt;") & "</text>" &
    "<text x='404' y='56' font-size='28' font-weight='700' fill='#006750' text-anchor='end'>" & Text(varBoxTotal) & "</text>" &
    "<text x='404' y='71' font-size='8.5' font-weight='600' letter-spacing='.6' fill='#606a70' text-anchor='end'>" & varBoxTotLbl & "</text>" &
    If( varBoxPending > 0,
        "<g class='brz'><rect x='64' y='80' width='" & Text(7*Len(Text(varBoxPending))+66) & "' height='17' rx='8.5' fill='#FBEEDF'/>" &
        "<text x='" & Text(64+(7*Len(Text(varBoxPending))+66)/2) & "' y='91' font-size='10' font-weight='600' fill='#d36d00' text-anchor='middle'>+" & Text(varBoxPending) & " pending</text></g>",
        "" ) &
    "<line x1='18' y1='104' x2='402' y2='104' stroke='#d4d8db'/>" &
    Concat(
        Table(
            { i:0, lbl:"New CC Logo / IB Upsell", val:varB1, col:"#0070f8" },
            { i:1, lbl:"CAP Engagement",          val:varB2, col:"#04909d" },
            { i:2, lbl:"CAP Orders Booked",       val:varB3, col:"#009a71" },
            { i:3, lbl:"Customer Centricity",     val:varB4, col:"#7764fc" },
            { i:4, lbl:"Accreditation Race",      val:varB5, col:"#cc54a4" },
            { i:5, lbl:"IP Push",                 val:varB6, col:"#d25f4b" }
        ),
        With(
            { x: 18 + Mod(i,2)*198, y: 112 + Int(i/2)*62 },
            "<g class='fo' style='animation-delay:" & Text(280 + i*70) & "ms'>" &
            "<rect x='" & Text(x) & "' y='" & Text(y) & "' width='186' height='54' rx='10' fill='#fbfcfc' stroke='#d4d8db'/>" &
            "<rect x='" & Text(x) & "' y='" & Text(y) & "' width='5' height='54' rx='2.5' fill='" & col & "'/>" &
            "<circle cx='" & Text(x+20) & "' cy='" & Text(y+19) & "' r='3.5' fill='" & col & "'/>" &
            "<text x='" & Text(x+30) & "' y='" & Text(y+22) & "' font-size='10.5' font-weight='600' fill='#606a70'>" & lbl & "</text>" &
            "<text x='" & Text(x+16) & "' y='" & Text(y+43) & "' font-size='19' font-weight='700' fill='#292d3a'>" & Text(val) & "</text>" &
            "</g>"
        )
    ) &
    "</g></svg>"
)
