// ============================================================================
//  App.OnStart  —  loading flag + Crew Portal / transition state.
//  The data build runs in Screen.OnVisible; this just primes the variables so
//  references never start blank.
//    varReady    — drives the optional loading overlay (set true once built)
//    varSelOpp   — the selected opportunity record on the Crew Portal (blank = none)
//    varLeafKey  — bumped on every page transition to force the leaf-wipe overlay
//                  to reload and replay its animation
//    varLeafBusy — true while the leaf-wipe transition overlay is showing
// ============================================================================
Set( varReady, false );
Set( varSelOpp, Blank() );
Set( varLeafKey, 0 );
Set( varLeafBusy, false );
Set( varTestCrew, "" );         // diagnostic role-override: a crew NAME to impersonate ("" = the real signed-in user). Use "" (not Blank()) so the var has a Text type.

// ---- Percy (AI assistant) ----
Set( varPercyOpen, false );     // chat container visibility
Set( varChatClosing, false );   // true while the close animation plays
Set( varChatKey, 0 );           // bumped on open/close to replay imgChatBg's animation
Set( varPercyThinking, false ); // true while awaiting the AI reply
Set( varSessionId, GUID() );    // conversation id (pass to the flow / SharePoint)
// seed the transcript with Percy's greeting (Seq orders the gallery)
// (use the literal emoji — Char() only accepts 1-255, so Char(128075) errors)
ClearCollect( colChat,
    { Seq: 1, Role: "percy", Body: "Hi, I'm Percy 👋 Ask me anything about the 1% Club dashboard." } );
