// ============================================================================
//  lblDebugSchema.Text  —  shows the first row's values, each read through text
//  ( & "" ) so it can't crash the way JSON() did. If every line shows a value,
//  the columns are readable and OnVisible will build colMembers. If THIS label
//  itself errors on a line, that column's type is broken in the Power BI model
//  (set it to Whole Number) — the line that errors names the culprit.
//  Label props: Wrap=true, AutoHeight=true, Size=10, X=16, Y=180, Width=700.
// ============================================================================
"FIRST ROW (read as text):" & Char(10) &
"Name = " & (First(PowerBIIntegration.Data).Name & "") & Char(10) &
"Crew = " & (First(PowerBIIntegration.Data).Crew & "") & Char(10) &
"User Email = " & (First(PowerBIIntegration.Data).'User Email' & "") & Char(10) &
"Manager Sponsor Email = " & (First(PowerBIIntegration.Data).'Manager Sponsor Email' & "") & Char(10) &
"IB & NS Points = " & (First(PowerBIIntegration.Data).'IB & NS Points' & "") & Char(10) &
"Manager Sponsor Points = " & (First(PowerBIIntegration.Data).'Manager Sponsor Points' & "") & Char(10) &
"New CC Logo Points = " & (First(PowerBIIntegration.Data).'New CC Logo Points' & "") & Char(10) &
"Cap Won Points = " & (First(PowerBIIntegration.Data).'Cap Won Points' & "") & Char(10) &
"Cap Requests = " & (First(PowerBIIntegration.Data).'Cap Requests' & "") & Char(10) &
"Customer Centricity Points = " & (First(PowerBIIntegration.Data).'Customer Centricity Points' & "") & Char(10) &
"IP in GL points = " & (First(PowerBIIntegration.Data).'IP in GL points' & "")
