// ============================================================================
//  ORDER PROGRESS RAIL (NON-gallery).  Control: Image "imgOrderAnchor"
//  Geometry: X=984  Y=68  Width=136  Height=556   ImagePosition=Fit
//
//  The yearly ORDER GOAL, drawn as an anchor on a chain: the higher the anchor
//  rides, the closer the crew is to the goal. 100% = anchor hoisted to the deck
//  (GRAND PRIZE, gold); 50%+ = being pulled up (HOISTING, green); under 50% =
//  being dropped back into the water (DROPPING, amber) and rewards reduce.
//  Anchor travel maps 0%->y=470 (in the water) and 100%->y=140 (at the deck).
//  Value comes from varOrderProgPct (Screen.OnVisible step 9); blank reads 0.
// ============================================================================
"data:image/svg+xml;utf8," & EncodeUrl(
    "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 136 556' font-family='Segoe UI, Arial, sans-serif'>" & varSvgCss &
    With(
        { p: Min( 100, Max( 0, Coalesce( varOrderProgPct, 0 ) ) ) },
        With(
            { ay:  470 - Min( 100, Max( 0, Coalesce( varOrderProgPct, 0 ) ) ) * 3.12,
              col: If( p >= 100, "#E0A300", If( p >= 50, "#01a982", "#d36d00" ) ),
              lbl: If( p >= 100, "GRAND PRIZE", If( p >= 50, "HOISTING", "DROPPING" ) ) },
            "<clipPath id='oclip'><rect x='0' y='0' width='136' height='556' rx='14'/></clipPath>" &
            "<g class='fu'>" &
            "<rect x='0.5' y='0.5' width='135' height='555' rx='14' fill='#ffffff' stroke='#d4d8db'/>" &
            "<g clip-path='url(#oclip)'>" &
            "<rect x='0' y='0' width='136' height='5' fill='" & col & "'/>" &
            "<path d='M0,398 q17,-8 34,0 t34,0 t34,0 t34,0 v158 h-136 z' fill='#eaf4fb'/>" &
            "<path d='M0,414 q17,-8 34,0 t34,0 t34,0 t34,0 v142 h-136 z' fill='#dcecf8'/>" &
            "<rect x='0' y='540' width='136' height='16' fill='#efe6cf'/>" &
            "</g>" &
            "<text x='68' y='26' font-size='9' font-weight='700' letter-spacing='1.1' fill='#606a70' text-anchor='middle'>ORDER PROGRESS</text>" &
            "<text x='68' y='64' font-size='30' font-weight='700' fill='" & col & "' text-anchor='middle'>" & Text( Round( p, 0 ) ) & "%</text>" &
            "<text x='68' y='81' font-size='7.5' font-weight='600' letter-spacing='.5' fill='#8a9096' text-anchor='middle'>OF THE YEARLY GOAL</text>" &
            "<rect x='18' y='90' width='100' height='21' rx='10.5' fill='" & col & "'/>" &
            "<text x='68' y='101' font-size='9' font-weight='700' letter-spacing='.8' fill='#ffffff' text-anchor='middle' dominant-baseline='central'>" & lbl & "</text>" &
            "<line x1='14' y1='130' x2='122' y2='130' stroke='#c2c8cd' stroke-width='2'/>" &
            "<circle cx='68' cy='130' r='5' fill='#ffffff' stroke='#8a9096' stroke-width='2'/>" &
            "<line x1='14' y1='140' x2='122' y2='140' stroke='#c9ced2' stroke-dasharray='3 3'/>" &
            "<text x='14' y='136' font-size='7' font-weight='600' fill='#a7adb2'>GOAL</text>" &
            "<text x='14' y='308' font-size='7' fill='#b0b6bb'>50%</text>" &
            "<text x='14' y='474' font-size='7' fill='#b0b6bb'>0%</text>" &
            "<line x1='68' y1='" & Text( Round( ay + 18, 1 ) ) & "' x2='68' y2='470' stroke='#c9ced2' stroke-dasharray='2 4'/>" &
            "<line x1='68' y1='134' x2='68' y2='" & Text( Round( ay - 22, 1 ) ) & "' stroke='#8a9096' stroke-width='2.5' stroke-dasharray='4 3'/>" &
            "<g class='bob'>" &
            "<circle cx='68' cy='" & Text( Round( ay - 18, 1 ) ) & "' r='4.5' fill='none' stroke='" & col & "' stroke-width='2.5'/>" &
            "<path d='M68," & Text( Round( ay - 14, 1 ) ) & " L68," & Text( Round( ay + 14, 1 ) ) & "' stroke='" & col & "' stroke-width='2.5' stroke-linecap='round'/>" &
            "<path d='M55," & Text( Round( ay - 5, 1 ) ) & " L81," & Text( Round( ay - 5, 1 ) ) & "' stroke='" & col & "' stroke-width='2.5' stroke-linecap='round'/>" &
            "<path d='M52," & Text( Round( ay + 1, 1 ) ) & " C53," & Text( Round( ay + 12, 1 ) ) & " 60," & Text( Round( ay + 17, 1 ) ) & " 68," & Text( Round( ay + 14, 1 ) ) &
                " C76," & Text( Round( ay + 17, 1 ) ) & " 83," & Text( Round( ay + 12, 1 ) ) & " 84," & Text( Round( ay + 1, 1 ) ) & "' fill='none' stroke='" & col & "' stroke-width='2.5' stroke-linecap='round'/>" &
            "</g>" &
            If( p >= 50,
                "<path d='M104," & Text( Round( ay + 6, 1 ) ) & " l0,-16 m-5,5 l5,-5 l5,5' fill='none' stroke='" & col & "' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'/>",
                "<path d='M104," & Text( Round( ay - 10, 1 ) ) & " l0,16 m-5,-5 l5,5 l5,-5' fill='none' stroke='" & col & "' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'/>" ) &
            "<text x='68' y='522' font-size='7.5' font-weight='600' fill='#3e4550' text-anchor='middle'>" &
                If( p >= 100, "Goal hit - grand prize is on", "Hit 100% for the grand prize" ) & "</text>" &
            "<text x='68' y='534' font-size='7' fill='#606a70' text-anchor='middle'>" &
                If( p >= 100, "keep it above the line", "below goal = reduced rewards" ) & "</text>" &
            "</g>"
        )
    ) &
    "</svg>"
)
