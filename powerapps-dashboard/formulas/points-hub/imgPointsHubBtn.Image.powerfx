// ============================================================================
//  POINTS HQ BUTTON (SVG).  Control: Image "imgPointsHubBtn"
//  Geometry on the dashboard ribbon:  X=570  Y=11  Width=140  Height=30
//        ImagePosition = Fit
//  Sibling of imgCrewPortalBtn but in the DARK green (#006750) so the two ribbon
//  actions read differently at a glance. Tiny rising-bars glyph = "points
//  breakdown"; chevron nudges right; fades up on load; reduced-motion safe.
//  Visible  = imgPointsHubBtn.Visible.powerfx  (the admin list lives THERE)
//  OnSelect = imgPointsHubBtn.OnSelect.powerfx
// ============================================================================
"data:image/svg+xml;utf8," & EncodeUrl(
    "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 140 30' font-family='Segoe UI, Arial, sans-serif'>" & varSvgCss &
    "<style>.nudge{animation:nudge 2.2s ease-in-out infinite;transform-box:fill-box;transform-origin:center}@keyframes nudge{0%,100%{transform:translateX(0)}50%{transform:translateX(3px)}}@media(prefers-reduced-motion:reduce){.nudge{animation:none}}</style>" &
    "<g class='fu'>" &
    "<rect x='1' y='1' width='138' height='28' rx='14' fill='#006750'/>" &
    "<rect x='1' y='1' width='138' height='14' rx='13' fill='#ffffff' opacity='.12'/>" &
    "<g class='gx' style='animation-delay:.25s'>" &
    "<rect x='14' y='16' width='4' height='6' rx='1.5' fill='#ffffff' opacity='.95'/>" &
    "<rect x='20' y='12' width='4' height='10' rx='1.5' fill='#ffffff' opacity='.95'/>" &
    "<rect x='26' y='8'  width='4' height='14' rx='1.5' fill='#ffffff' opacity='.95'/>" &
    "</g>" &
    "<text x='38' y='16' font-size='13' font-weight='600' fill='#ffffff' dominant-baseline='central'>Points HQ</text>" &
    "<path d='M122,11 l5,4 l-5,4' fill='none' stroke='#ffffff' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='nudge'/>" &
    "</g>" &
    "</svg>"
)
