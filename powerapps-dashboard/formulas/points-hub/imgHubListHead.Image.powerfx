// ============================================================================
//  CREWS LIST HEADER (NON-gallery).  Control: Image "imgHubListHead"
//  Geometry: X=16  Y=110  Width=1104  Height=26   ImagePosition=Fit
//  Visible:  varHubView = "crews"
//  Left: section title. Right: a live hint that tracks the legend filter —
//  and a data warning if the collections are empty (page opened cold).
// ============================================================================
"data:image/svg+xml;utf8," & EncodeUrl(
    "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1104 26' font-family='Segoe UI, Arial, sans-serif'>" & varSvgCss &
    "<g class='fo'>" &
    "<text x='4' y='17' font-size='11' font-weight='700' letter-spacing='1.2' fill='#606a70'>ALL CREWS &#183; POINTS BREAKDOWN</text>" &
    "<text x='1100' y='17' font-size='11' fill='#606a70' text-anchor='end'>" &
    If( CountRows( colHubCrews ) = 0,
        "no data yet &#8212; go back and reopen from the dashboard",
        If( varHubCat = "",
            "stacked by category &#183; tap a crew to drill in",
            "ranked on " &
            Substitute(Substitute(Substitute( LookUp( colHubCats, Key = varHubCat, Lbl ), "&","&amp;"),"<","&lt;"),">","&gt;") &
            " only &#183; tap the chip again to clear"
        )
    ) &
    "</text>" &
    "</g>" &
    "</svg>"
)
