// ============================================================================
//  OPPORTUNITY ROW (GALLERY template).  Control: Image "imgOppRow"
//  Gallery "galCrewOpps":  Items = colOpps   X=16 Y=262 Width=420 Height=362
//        TemplateSize=64   TemplatePadding=0   ShowScrollbar=false
//  Inside template, Image "imgOppRow": X=0 Y=0 Width=Parent.TemplateWidth
//        Height=Parent.TemplateHeight  ImagePosition=Fit  Image = (below)
//  Left: Name + Account.  Right: Value (top) + Close date (below).
//  Bottom-left: Funnel Type chip (filled) + Forecast pill (muted).
//  COLOUR CODING = FUNNEL TYPE (accent bar + funnel chip).  Selected row
//  (varSelOpp.OppId = ThisItem.OppId) tints green.
// ============================================================================
"data:image/svg+xml;utf8," & EncodeUrl(
    "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 420 64' font-family='Segoe UI, Arial, sans-serif'>" & varSvgCss &
    With(
        { sel: varSelOpp.OppId = ThisItem.OppId,
          ftc: Switch( ThisItem.FunnelType, "Upsell","#0070f8", "New Logo","#009a71", "Renewal","#04909d", "Cross-sell","#7764fc", "Expansion","#cc54a4", "#606a70" ),
          fc:  Switch( ThisItem.ForecastCategory, "Commit","#009a71", "Best Case","#0070f8", "Pipeline","#04909d", "Upside","#7764fc", "Omitted","#606a70", "#606a70" ),
          nm:  Substitute(Substitute(Substitute( Left(ThisItem.OppName, 30), "&","&amp;"),"<","&lt;"),">","&gt;"),
          ac:  Substitute(Substitute(Substitute( Left(ThisItem.AccountName, 28), "&","&amp;"),"<","&lt;"),">","&gt;"),
          ft:  Left(ThisItem.FunnelType, 16),
          fcat:Substitute(Substitute(Substitute( ThisItem.ForecastCategory, "&","&amp;"),"<","&lt;"),">","&gt;"),
          cd:  Text( IfError( ThisItem.CloseDate, Blank() ), "dd mmm yyyy" ) },
        "<g class='rw' style='animation-delay:" & Text( 60 + ThisItem.Idx*50 ) & "ms'>" &
        "<rect x='2' y='2' width='416' height='60' rx='11' fill='" & If(sel,"#d1ffee","#ffffff") & "' stroke='" & If(sel,"#01a982","#d4d8db") & "' stroke-width='" & If(sel,"2","1") & "'/>" &
        "<clipPath id='or'><rect x='2' y='2' width='416' height='60' rx='11'/></clipPath>" &
        "<rect x='2' y='2' width='5' height='60' rx='2.5' fill='" & ftc & "' clip-path='url(#or)'/>" &
        // left: name + account
        "<text x='16' y='22' font-size='13' font-weight='700' fill='#292d3a'>" & nm & "</text>" &
        "<text x='16' y='39' font-size='10.5' fill='#606a70'>" & ac & "</text>" &
        // right: value (top) + close date (below)
        "<text x='404' y='24' font-size='14' font-weight='700' fill='#006750' text-anchor='end'>" & Text( ThisItem.TotalValue, "#,##0" ) & "</text>" &
        "<text x='404' y='44' font-size='10.5' fill='#606a70' text-anchor='end'>" & cd & "</text>" &
        // bottom-left: funnel chip (filled, funnel colour) + forecast pill (muted)
        With(
            { fw: Round( 6.5*Len(ft) + 16, 0 ) },
            "<rect x='16' y='46' width='" & Text(fw) & "' height='15' rx='7.5' fill='" & ftc & "'/>" &
            "<text x='" & Text( Round(16 + fw/2, 0) ) & "' y='54' font-size='9' font-weight='700' fill='#ffffff' text-anchor='middle' dominant-baseline='central'>" &
                Substitute(Substitute(Substitute( ft, "&","&amp;"),"<","&lt;"),">","&gt;") & "</text>" &
            With(
                { pw: Round( 6.5*Len(ThisItem.ForecastCategory) + 16, 0 ), px: 16 + fw + 6 },
                "<rect x='" & Text(px) & "' y='46' width='" & Text(pw) & "' height='15' rx='7.5' fill='#f2f3f4'/>" &
                "<text x='" & Text( Round(px + pw/2, 0) ) & "' y='54' font-size='9' font-weight='700' fill='" & fc & "' text-anchor='middle' dominant-baseline='central'>" & fcat & "</text>"
            )
        ) &
        "</g>"
    ) &
    "</svg>"
)
