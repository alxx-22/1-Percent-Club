{
  "_comment": "REFERENCE workflow definition for ANY Percy tool flow. All 8 tools share this shape — only the input param(s), the validation regex, and the DAX body differ (see dax-templates.md). This example = Percy-Tool-CompleteCare (Template B, input OPE). Trigger = Copilot Studio calls the flow; action = Power BI 'Run a query against a dataset'; return = compact JSON to the agent. VERIFY connector operationIds + connections on import.",
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
      "$workspaceId": { "type": "string", "metadata": { "description": "Power BI workspace id" } },
      "$datasetId":   { "type": "string", "metadata": { "description": "Semantic model (dataset) id" } }
    },
    "triggers": {
      "When_Copilot_calls_the_flow": {
        "type": "OpenApiConnectionWebhook",
        "_comment": "Microsoft Copilot Studio connector trigger. Define ONE text input: 'ope' (and 'who' for the CAP / Customer Centricity tools).",
        "inputs": {
          "host": { "connectionName": "shared_microsoftcopilotstudio", "operationId": "CreateFlowTrigger", "apiId": "/providers/Microsoft.PowerApps/apis/shared_microsoftcopilotstudio" },
          "parameters": { "schema": { "type": "object", "properties": { "ope": { "type": "string" }, "who": { "type": "string" } } } }
        }
      }
    },
    "actions": {
      "Validate_OPE": {
        "type": "If",
        "_comment": "Injection guard. Reject anything that isn't an OPE before it touches the DAX.",
        "expression": { "and": [ { "not": { "equals": [ "@coalesce(triggerBody()?['ope'], '')", "" ] } } ] },
        "actions": {
          "Compose_DaxQuery": {
            "type": "Compose",
            "_comment": "Paste Template B from PERCY_BUILD_PACK.md §10.2 in place of the body below; keep the @@OPE@@ token on the VAR Ope line. For tools that take an email, also replace @@WHO@@.",
            "inputs": "@replace('DEFINE VAR Ope = \"@@OPE@@\" VAR OppRows = FILTER ( ''Final'', ''Final''[HPE Opportunity Id] = Ope ) EVALUATE ROW ( \"OPE\", Ope, \"Found\", IF ( COUNTROWS ( OppRows ) > 0, \"Yes\", \"No\" ) )', '@@OPE@@', toUpper(trim(triggerBody()?['ope'])))"
          },
          "Run_a_query_against_a_dataset": {
            "type": "OpenApiConnection",
            "runAfter": { "Compose_DaxQuery": [ "Succeeded" ] },
            "inputs": {
              "host": { "connectionName": "shared_pbi", "operationId": "ExecuteQueries", "apiId": "/providers/Microsoft.PowerApps/apis/shared_pbi" },
              "parameters": {
                "groupId": "@parameters('$workspaceId')",
                "datasetId": "@parameters('$datasetId')",
                "requestBody": { "queries": [ { "query": "@outputs('Compose_DaxQuery')" } ], "serializerSettings": { "includeNulls": true } }
              }
            }
          },
          "Project_evidence": {
            "type": "Compose",
            "runAfter": { "Run_a_query_against_a_dataset": [ "Succeeded" ] },
            "_comment": "First row of the first table = the compact evidence object Percy reads.",
            "inputs": "@first(body('Run_a_query_against_a_dataset')?['results']?[0]?['tables']?[0]?['rows'])"
          },
          "Return_to_Copilot": {
            "type": "OpenApiConnection",
            "runAfter": { "Project_evidence": [ "Succeeded" ] },
            "inputs": {
              "host": { "connectionName": "shared_microsoftcopilotstudio", "operationId": "RespondToFlow", "apiId": "/providers/Microsoft.PowerApps/apis/shared_microsoftcopilotstudio" },
              "parameters": { "evidence": "@string(outputs('Project_evidence'))" }
            }
          }
        },
        "else": {
          "actions": {
            "Return_invalid_ope": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": { "connectionName": "shared_microsoftcopilotstudio", "operationId": "RespondToFlow", "apiId": "/providers/Microsoft.PowerApps/apis/shared_microsoftcopilotstudio" },
                "parameters": { "evidence": "{\"error\":\"invalid_ope\"}" }
              }
            }
          }
        }
      }
    }
  }
}
